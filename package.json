{
  "name": "pingroom-starter-recipe-blend",
  "version": "1.0.0",
  "private": true,
  "description": "Collect constituent fractions through PingRoom and find an exact integer-part recipe within a target composition band.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/cli.js run",
    "connect": "node src/cli.js connect",
    "inspect": "node src/cli.js inspect",
    "status": "node src/cli.js status",
    "report": "node src/cli.js report",
    "find-id": "node src/cli.js find",
    "recover": "node src/cli.js recover",
    "demo": "node src/demo.js",
    "test": "node --test",
    "validate": "node src/cli.js validate",
    "export": "node src/cli.js export",
    "export-analysis": "node src/cli.js export-analysis"
  },
  "dependencies": {
    "@pingroom/sdk": "0.7.1"
  },
  "license": "MIT"
}
